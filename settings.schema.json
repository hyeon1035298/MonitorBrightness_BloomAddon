{
  "schema": 1,
  "groups": [
    {
      "id": "taskbar",
      "name": {
        "ko": "작업표시줄",
        "en": "Taskbar",
        "ja": "タスクバー",
        "zh": "任务栏"
      },
      "items": [
        {
          "key": "taskbar.number",
          "type": "choice",
          "default": 0,
          "file": "prefs.json",
          "field": "pillNumber",
          "name": {
            "ko": "작업표시줄 숫자",
            "en": "Taskbar number",
            "ja": "タスクバーの数値",
            "zh": "任务栏数值"
          },
          "options": [
            {
              "value": 0,
              "name": {
                "ko": "첫 모니터",
                "en": "First monitor",
                "ja": "最初のモニター",
                "zh": "第一台显示器"
              },
              "easy": {
                "name": { "ko": "첫 모니터", "en": "First monitor", "ja": "最初のモニター", "zh": "第一台显示器" },
                "picture": {
                  "shapes": [
                    { "box": [3, 4, 28, 19], "r": 3, "alpha": 0.05 },
                    { "box": [3, 4, 28, 19], "r": 3, "stroke": "ink", "alpha": 0.45 },
                    { "box": [41, 4, 28, 19], "r": 3, "alpha": 0.05 },
                    { "box": [41, 4, 28, 19], "r": 3, "stroke": "ink", "alpha": 0.45 },
                    { "text": "70", "at": [17, 13.5], "width": 24, "size": 9, "fill": "accent" },
                    { "text": "40", "at": [55, 13.5], "width": 24, "size": 9, "alpha": 0.55 },
                    { "box": [1.5, 2.5, 31, 22], "r": 4, "stroke": "accent", "width": 1.5 },
                    { "text": "70", "at": [36, 36], "size": 10, "fill": "accent" }
                  ]
                }
              }
            },
            {
              "value": 1,
              "name": {
                "ko": "평균",
                "en": "Average",
                "ja": "平均",
                "zh": "平均值"
              },
              "easy": {
                "name": { "ko": "평균", "en": "Average", "ja": "平均", "zh": "平均值" },
                "picture": {
                  "shapes": [
                    { "box": [3, 4, 28, 19], "r": 3, "alpha": 0.05 },
                    { "box": [3, 4, 28, 19], "r": 3, "stroke": "ink", "alpha": 0.45 },
                    { "box": [41, 4, 28, 19], "r": 3, "alpha": 0.05 },
                    { "box": [41, 4, 28, 19], "r": 3, "stroke": "ink", "alpha": 0.45 },
                    { "text": "70", "at": [17, 13.5], "width": 24, "size": 9, "fill": "accent" },
                    { "text": "40", "at": [55, 13.5], "width": 24, "size": 9, "fill": "accent" },
                    { "box": [1.5, 2.5, 31, 22], "r": 4, "stroke": "accent", "width": 1.5 },
                    { "box": [39.5, 2.5, 31, 22], "r": 4, "stroke": "accent", "width": 1.5 },
                    { "text": "55", "at": [36, 36], "size": 10, "fill": "accent" }
                  ]
                }
              }
            }
          ],
          "easy": {
            "name": {
              "ko": "작업표시줄에 보일 밝기",
              "en": "Brightness shown on taskbar",
              "ja": "タスクバーに表示する明るさ",
              "zh": "任务栏显示的亮度"
            },
            "about": ""
          }
        },
        {
          "key": "taskbar.wheelStep",
          "type": "int",
          "default": 5,
          "file": "prefs.json",
          "field": "wheelStep",
          "name": {
            "ko": "휠 한 칸 (%)",
            "en": "Wheel step (%)",
            "ja": "ホイール1目盛り (%)",
            "zh": "滚轮步进 (%)"
          },
          "min": 1,
          "max": 25,
          "easy": {
            "name": { "ko": "휠 한 칸에", "en": "Per wheel step", "ja": "ホイール1目盛りあたり", "zh": "每格滚轮" },
            "about": {
              "ko": "작업표시줄 아이콘 위에서 휠을 돌릴 때",
              "en": "When scrolling over the taskbar icon",
              "ja": "タスクバーアイコン上でホイールを回した時",
              "zh": "在任务栏图标上滚动鼠标滚轮时"
            }
          }
        },
        {
          "key": "taskbar.link",
          "type": "bool",
          "default": false,
          "file": "prefs.json",
          "field": "link",
          "name": {
            "ko": "모든 모니터 함께 조절",
            "en": "Adjust all monitors together",
            "ja": "すべてのモニターを連動して調整",
            "zh": "同步调节所有显示器"
          },
          "about": {
            "ko": "한 모니터를 바꾸면 창에 보이는 다른 모니터도 같은 밝기가 됩니다",
            "en": "Changing one monitor sets all other visible monitors in the window to the same brightness",
            "ja": "1つのモニターを変更すると、ウィンドウに表示されている他のモニターも同じ明るさになります",
            "zh": "调节一台显示器时，窗口中显示的其他显示器也会设为相同亮度"
          },
          "easy": {
            "name": { "ko": "모든 모니터 함께", "en": "All monitors together", "ja": "すべてのモニターを連動", "zh": "所有显示器同步" },
            "about": {
              "ko": "한 모니터를 바꾸면 다른 모니터도 같은 밝기가 됩니다",
              "en": "Changing one monitor sets other monitors to the same brightness",
              "ja": "1つのモニターを変更すると、他のモニターも同じ明るさになります",
              "zh": "调节一台显示器时，其他显示器也会设为相同亮度"
            },
            "thumb": {
              "shapes": [
                { "box": [3, 8, 21, 15], "r": 2.5, "alpha": 0.05 },
                { "box": [3, 8, 21, 15], "r": 2.5, "stroke": "ink", "alpha": 0.45 },
                { "box": [36, 8, 21, 15], "r": 2.5, "alpha": 0.05 },
                { "box": [36, 8, 21, 15], "r": 2.5, "stroke": "ink", "alpha": 0.45 },
                { "path": "M 25.5,15.5 H 34.5", "stroke": "accent", "width": 1.3 },
                { "dot": [25.5, 15.5, 1.4], "fill": "accent" },
                { "dot": [34.5, 15.5, 1.4], "fill": "accent" },
                { "box": [10, 25, 7, 1.6], "r": 0.8, "alpha": 0.18 },
                { "box": [43, 25, 7, 1.6], "r": 0.8, "alpha": 0.18 }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "ranges",
      "name": {
        "ko": "모니터별 범위",
        "en": "Per-monitor range",
        "ja": "モニター別の範囲",
        "zh": "各显示器范围"
      },
      "about": {
        "ko": "창의 0과 100이 가리킬 하드웨어 밝기입니다",
        "en": "Hardware brightness levels corresponding to 0 and 100 in the window",
        "ja": "ウィンドウ上の 0 と 100 に対応するハードウェアの明るさです",
        "zh": "窗口中 0 与 100 对应的硬件亮度范围"
      },
      "items": [
        {
          "key": "ranges.monitors",
          "type": "records",
          "default": {},
          "file": "prefs.json",
          "field": "monitors",
          "label": "name",
          "name": {
            "ko": "모니터별 범위",
            "en": "Per-monitor range",
            "ja": "モニター別の範囲",
            "zh": "各显示器范围"
          },
          "fields": [
            {
              "key": "lo",
              "type": "int",
              "default": 0,
              "min": 0,
              "max": 99,
              "name": {
                "ko": "최저 밝기 (%)",
                "en": "Min brightness (%)",
                "ja": "最低輝度 (%)",
                "zh": "最低亮度 (%)"
              }
            },
            {
              "key": "hi",
              "type": "int",
              "default": 100,
              "min": 1,
              "max": 100,
              "name": {
                "ko": "최고 밝기 (%)",
                "en": "Max brightness (%)",
                "ja": "最高輝度 (%)",
                "zh": "最高亮度 (%)"
              }
            },
            {
              "key": "hidden",
              "type": "bool",
              "default": false,
              "name": {
                "ko": "창에서 숨기기",
                "en": "Hide from window",
                "ja": "ウィンドウから隠す",
                "zh": "在窗口中隐藏"
              }
            }
          ]
        }
      ],
      "easy": {
        "name": { "ko": "모니터마다 밝기 범위", "en": "Brightness range per monitor", "ja": "モニターごとの明るさ範囲", "zh": "各显示器亮度范围" },
        "about": {
          "ko": "밝기 0과 100이 모니터의 실제 밝기 어디를 가리킬지 정합니다",
          "en": "Set which actual monitor brightness levels correspond to 0 and 100",
          "ja": "明るさの 0 と 100 がモニターの実際のどの明るさに対応するかを指定します",
          "zh": "设置亮度 0 和 100 对应显示器的实际亮度值"
        },
        "folded": true
      }
    },
    {
      "id": "keys",
      "name": {
        "ko": "단축키",
        "en": "Shortcuts",
        "ja": "ショートカット",
        "zh": "快捷键"
      },
      "items": [
        {
          "key": "keys.up",
          "type": "hotkey",
          "default": {
            "mods": 3,
            "vk": 38
          },
          "file": "prefs.json",
          "field": "keyUp",
          "name": {
            "ko": "밝게",
            "en": "Brighter",
            "ja": "明るく",
            "zh": "调亮"
          },
          "easy": {
            "name": { "ko": "밝게", "en": "Brighter", "ja": "明るく", "zh": "调亮" },
            "about": {
              "ko": "누른 뒤 새 조합을 누르세요",
              "en": "Click and press a new key combination",
              "ja": "クリックしてから新しいキーの組み合わせを押してください",
              "zh": "点击后按下新的按键组合"
            }
          }
        },
        {
          "key": "keys.down",
          "type": "hotkey",
          "default": {
            "mods": 3,
            "vk": 40
          },
          "file": "prefs.json",
          "field": "keyDown",
          "name": {
            "ko": "어둡게",
            "en": "Dimmer",
            "ja": "暗く",
            "zh": "调暗"
          },
          "easy": { "name": { "ko": "어둡게", "en": "Dimmer", "ja": "暗く", "zh": "调暗" }, "about": "" }
        },
        {
          "key": "keys.step",
          "type": "int",
          "default": 10,
          "file": "prefs.json",
          "field": "keyStep",
          "name": {
            "ko": "한 번에 (%)",
            "en": "Step size (%)",
            "ja": "1回あたりの変化量 (%)",
            "zh": "单次步进 (%)"
          },
          "min": 1,
          "max": 50,
          "easy": { "name": { "ko": "한 번 누를 때", "en": "Per key press", "ja": "1回押すごとに", "zh": "每次按下时" } }
        }
      ]
    },
    {
      "id": "idle",
      "name": {
        "ko": "유휴 시 어둡게",
        "en": "Dim when idle",
        "ja": "アイドル時に暗くする",
        "zh": "闲置时变暗"
      },
      "items": [
        {
          "key": "idle.on",
          "type": "bool",
          "default": false,
          "file": "prefs.json",
          "field": "idleOn",
          "name": {
            "ko": "유휴 시 어둡게",
            "en": "Dim when idle",
            "ja": "アイドル時に暗くする",
            "zh": "闲置时变暗"
          },
          "about": {
            "ko": "입력이 오면 원래 밝기로 돌아갑니다. 동영상처럼 화면을 켜 두는 프로그램이 있으면 어둡게 하지 않습니다",
            "en": "Restores original brightness on input. Does not dim while an app like a video player is keeping the screen awake",
            "ja": "入力があると元の明るさに戻ります。動画再生など画面を常時点灯させるプログラムが動作中は暗くしません",
            "zh": "有输入操作时恢复原亮度。若有视频等保持屏幕常亮的程序运行则不会变暗"
          },
          "easy": {
            "name": { "ko": "자리를 비우면 어둡게", "en": "Dim when away", "ja": "離席時に暗くする", "zh": "离开时变暗" },
            "about": {
              "ko": "마우스나 키보드를 쓰면 원래대로 돌아옵니다",
              "en": "Restores brightness when you use the mouse or keyboard",
              "ja": "マウスやキーボードを操作すると元の明るさに戻ります",
              "zh": "使用鼠标或键盘时恢复原亮度"
            }
          }
        },
        {
          "key": "idle.minutes",
          "type": "int",
          "default": 5,
          "file": "prefs.json",
          "field": "idleMinutes",
          "name": {
            "ko": "기다리는 시간(분)",
            "en": "Idle timeout (min)",
            "ja": "待機時間 (分)",
            "zh": "等待时间 (分钟)"
          },
          "min": 1,
          "max": 120,
          "easy": { "name": { "ko": "얼마 뒤에", "en": "After", "ja": "経過時間", "zh": "多久之后" }, "when": { "key": "idle.on" } }
        },
        {
          "key": "idle.level",
          "type": "int",
          "default": 20,
          "file": "prefs.json",
          "field": "idleLevel",
          "name": {
            "ko": "어둡게 할 밝기 (%)",
            "en": "Dimmed brightness (%)",
            "ja": "減光時の明るさ (%)",
            "zh": "变暗后亮度 (%)"
          },
          "min": 0,
          "max": 100,
          "easy": {
            "name": { "ko": "어둡게 할 밝기", "en": "Dimmed brightness", "ja": "減光時の明るさ", "zh": "变暗后亮度" },
            "when": { "key": "idle.on" }
          }
        }
      ],
      "easy": { "name": { "ko": "자리를 비우면 어둡게", "en": "Dim when away", "ja": "離席時に暗くする", "zh": "离开时变暗" } }
    },
    {
      "id": "pill",
      "name": {
        "ko": "모양",
        "en": "Appearance",
        "ja": "外観",
        "zh": "外观"
      },
      "items": [
        {
          "key": "pill.theme",
          "type": "choice",
          "default": "system",
          "options": [
            {
              "value": "system",
              "name": {
                "ko": "Windows 작업표시줄 테마",
                "en": "Windows taskbar theme",
                "ja": "Windows タスクバーのテーマ",
                "zh": "Windows 任务栏主题"
              }
            },
            {
              "value": "dark",
              "name": {
                "ko": "다크",
                "en": "Dark",
                "ja": "ダーク",
                "zh": "深色"
              }
            },
            {
              "value": "light",
              "name": {
                "ko": "라이트",
                "en": "Light",
                "ja": "ライト",
                "zh": "浅色"
              }
            }
          ],
          "name": {
            "ko": "테마",
            "en": "Theme",
            "ja": "テーマ",
            "zh": "主题"
          },
          "about": {
            "ko": "위젯과 창의 라이트·다크. Bloom 애드온으로 쓰면 Bloom의 테마를 따릅니다",
            "en": "Light or dark theme for the widget and window. When used as a Bloom add-on, it follows Bloom's theme",
            "ja": "ウィジェットとウィンドウのライト・ダークテーマ。Bloom アドオンとして使用する場合は Bloom のテーマに従います",
            "zh": "小组件与窗口的浅色或深色主题。作为 Bloom 插件使用时将跟随 Bloom 的主题"
          }
        },
        {
          "key": "pill.glass",
          "type": "bool",
          "default": true,
          "name": {
            "ko": "유리 효과",
            "en": "Glass effect",
            "ja": "ガラス効果",
            "zh": "玻璃效果"
          },
          "about": {
            "ko": "끄면 창이 블러 없이 테마 색으로 칠해집니다",
            "en": "When disabled, the window uses a solid theme color without blur",
            "ja": "オフにすると、ウィンドウはぼかしなしでテーマ色で塗りつぶされます",
            "zh": "关闭后窗口无模糊效果，直接填充主题色"
          }
        }
      ]
    }
  ],
  "easy": { "order": ["taskbar", "keys", "idle", "ranges"] }
}
